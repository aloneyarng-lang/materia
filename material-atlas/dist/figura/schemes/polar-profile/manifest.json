{
  "id": "polar-profile",
  "name": "环向 · 极坐标分布",
  "category": "角向分布",
  "apiVersion": 1,
  "version": "1.0.0",
  "description": "从全量参考库筛选的绘图结构。封面与数据为合成示例。",
  "cover": "cover.svg",
  "requires": [],
  "fields": [
    {
      "key": "angle",
      "label": "角度（度）",
      "type": "number",
      "min": 0
    },
    {
      "key": "radius",
      "label": "径向值",
      "type": "number",
      "min": 0
    },
    {
      "key": "group",
      "label": "系列",
      "type": "string"
    }
  ],
  "parameters": [
    {
      "key": "title",
      "label": "图标题",
      "type": "text",
      "default": "合成示例 · 环向 · 极坐标分布"
    },
    {
      "key": "width",
      "label": "画布宽度 px",
      "type": "number",
      "default": 900,
      "min": 400,
      "max": 2400
    },
    {
      "key": "height",
      "label": "画布高度 px",
      "type": "number",
      "default": 560,
      "min": 300,
      "max": 1800
    },
    {
      "key": "font",
      "label": "字体",
      "type": "select",
      "default": "Arial",
      "options": [
        "Arial",
        "Times New Roman",
        "Microsoft YaHei"
      ]
    },
    {
      "key": "fontSize",
      "label": "字号 px",
      "type": "number",
      "default": 14,
      "min": 8,
      "max": 30
    },
    {
      "key": "palette",
      "label": "配色",
      "type": "select",
      "default": "学术",
      "options": [
        "学术",
        "色觉友好"
      ]
    },
    {
      "key": "markerSize",
      "label": "散点半径",
      "type": "number",
      "default": 4,
      "min": 1,
      "max": 10
    },
    {
      "key": "radialLabel",
      "label": "径向量名称",
      "type": "text",
      "default": "Response"
    },
    {
      "key": "close",
      "label": "首尾连接",
      "type": "select",
      "default": "断开",
      "options": [
        "断开",
        "闭合"
      ]
    }
  ],
  "dataDescription": "角度 0–360°，0° 在右侧，逆时针增加。0° 与 360° 为同一方向，同组只保留一个。径向量须非负。仅在周期数据明确时选择闭合。"
}
