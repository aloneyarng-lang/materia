{
  "id": "stacked-share",
  "name": "构成 · 百分比堆叠",
  "apiVersion": 1,
  "version": "1.0.0",
  "description": "通用数据绘图方案；封面与数据为合成示例，非原论文结果。",
  "category": "分类比较",
  "cover": "cover.svg",
  "requires": [],
  "fields": [
    {
      "key": "category",
      "label": "类别",
      "type": "string"
    },
    {
      "key": "component",
      "label": "组成名称",
      "type": "string"
    },
    {
      "key": "value",
      "label": "非负组成量",
      "type": "number",
      "min": 0
    }
  ],
  "parameters": [
    {
      "key": "title",
      "label": "图标题",
      "type": "text",
      "default": "合成示例 · 构成 · 百分比堆叠"
    },
    {
      "key": "xLabel",
      "label": "X 轴名称",
      "type": "text",
      "default": "X"
    },
    {
      "key": "yLabel",
      "label": "Y 轴名称",
      "type": "text",
      "default": "Y"
    },
    {
      "key": "width",
      "label": "画布宽度 px",
      "type": "number",
      "default": 900,
      "min": 400,
      "max": 2400
    },
    {
      "key": "height",
      "label": "画布高度 px",
      "type": "number",
      "default": 560,
      "min": 300,
      "max": 1800
    },
    {
      "key": "font",
      "label": "字体",
      "type": "select",
      "default": "Arial",
      "options": [
        "Arial",
        "Times New Roman",
        "Microsoft YaHei"
      ]
    },
    {
      "key": "fontSize",
      "label": "字号 px",
      "type": "number",
      "default": 14,
      "min": 8,
      "max": 30
    },
    {
      "key": "palette",
      "label": "配色",
      "type": "select",
      "default": "学术",
      "options": [
        "学术",
        "色觉友好"
      ]
    },
    {
      "key": "barWidth",
      "label": "柱宽比例",
      "type": "number",
      "default": 0.65,
      "min": 0.1,
      "max": 0.95
    }
  ],
  "dataDescription": "每个 category/component 组合唯一，值非负且各类别总和须大于零。按类别总量归一到 100%，缺失组成视为未提供、显示 0；不推断相含量。"
}