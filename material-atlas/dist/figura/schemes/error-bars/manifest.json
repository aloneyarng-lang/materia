{
  "id": "error-bars",
  "apiVersion": 1,
  "version": "1.0.0",
  "name": "分组柱形与误差棒",
  "description": "合成演示方案；不是实际科研成果。",
  "category": "分类比较",
  "cover": "cover.svg",
  "requires": [],
  "dataDescription": "长表格式；第一行表头，每行一条观测。误差必须非负；不自动计算或推断 SD/SE/CI。类别与分组组合须唯一。",
  "fields": [
    {
      "key": "category",
      "label": "类别 / 样本名称",
      "type": "string"
    },
    {
      "key": "value",
      "label": "数值",
      "type": "number"
    },
    {
      "key": "error",
      "label": "对称误差（由用户定义）",
      "type": "number",
      "min": 0
    },
    {
      "key": "group",
      "label": "分组 / 图例",
      "type": "string"
    }
  ],
  "parameters": [
    {
      "key": "title",
      "label": "图标题",
      "type": "text",
      "default": "Synthetic example"
    },
    {
      "key": "xLabel",
      "label": "X 轴名称",
      "type": "text",
      "default": "X"
    },
    {
      "key": "yLabel",
      "label": "Y 轴名称",
      "type": "text",
      "default": "Y"
    },
    {
      "key": "width",
      "label": "画布宽度 px",
      "type": "number",
      "default": 900,
      "min": 400,
      "max": 2400
    },
    {
      "key": "height",
      "label": "画布高度 px",
      "type": "number",
      "default": 560,
      "min": 300,
      "max": 1800
    },
    {
      "key": "font",
      "label": "字体",
      "type": "select",
      "default": "Arial",
      "options": [
        "Arial",
        "Times New Roman",
        "Microsoft YaHei"
      ]
    },
    {
      "key": "fontSize",
      "label": "字号 px",
      "type": "number",
      "default": 14,
      "min": 8,
      "max": 30
    },
    {
      "key": "color",
      "label": "主色",
      "type": "color",
      "default": "#326b95"
    },
    {
      "key": "color2",
      "label": "第二色",
      "type": "color",
      "default": "#dc8751"
    },
    {
      "key": "legend",
      "label": "图例位置",
      "type": "select",
      "default": "右侧",
      "options": [
        "右侧",
        "左上",
        "隐藏"
      ]
    },
    {
      "key": "yMin",
      "label": "Y 最小值（留空自动）",
      "type": "text",
      "default": ""
    },
    {
      "key": "yMax",
      "label": "Y 最大值（留空自动）",
      "type": "text",
      "default": ""
    },
    {
      "key": "barWidth",
      "label": "柱宽比例",
      "type": "number",
      "default": 0.75,
      "min": 0.1,
      "max": 0.95
    }
  ]
}