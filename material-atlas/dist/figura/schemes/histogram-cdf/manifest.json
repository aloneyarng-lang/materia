{
  "id": "histogram-cdf",
  "name": "分布 · 频数与累计",
  "apiVersion": 1,
  "version": "1.0.0",
  "description": "通用数据绘图方案；封面与数据为合成示例，非原论文结果。",
  "category": "统计分布",
  "cover": "cover.svg",
  "requires": [],
  "fields": [
    {
      "key": "value",
      "label": "单次观测值",
      "type": "number"
    }
  ],
  "parameters": [
    {
      "key": "title",
      "label": "图标题",
      "type": "text",
      "default": "合成示例 · 分布 · 频数与累计"
    },
    {
      "key": "xLabel",
      "label": "X 轴名称",
      "type": "text",
      "default": "X"
    },
    {
      "key": "yLabel",
      "label": "Y 轴名称",
      "type": "text",
      "default": "Y"
    },
    {
      "key": "width",
      "label": "画布宽度 px",
      "type": "number",
      "default": 900,
      "min": 400,
      "max": 2400
    },
    {
      "key": "height",
      "label": "画布高度 px",
      "type": "number",
      "default": 560,
      "min": 300,
      "max": 1800
    },
    {
      "key": "font",
      "label": "字体",
      "type": "select",
      "default": "Arial",
      "options": [
        "Arial",
        "Times New Roman",
        "Microsoft YaHei"
      ]
    },
    {
      "key": "fontSize",
      "label": "字号 px",
      "type": "number",
      "default": 14,
      "min": 8,
      "max": 30
    },
    {
      "key": "bins",
      "label": "等宽分箱数",
      "type": "number",
      "default": 8,
      "min": 2,
      "max": 40
    },
    {
      "key": "color",
      "label": "频数柱颜色",
      "type": "color",
      "default": "#326b95"
    },
    {
      "key": "cdf",
      "label": "累计曲线",
      "type": "select",
      "default": "显示",
      "options": [
        "显示",
        "隐藏"
      ]
    }
  ],
  "dataDescription": "一行一个未加权观测值，不接收预汇总频数。柱为等宽分箱计数，累计线为精确经验分布 ECDF（右轴 0–100%），不拟合高斯或对数正态。"
}