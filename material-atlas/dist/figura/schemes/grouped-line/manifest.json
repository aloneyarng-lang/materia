{
  "id": "grouped-line",
  "apiVersion": 1,
  "version": "1.0.0",
  "name": "分组折线与散点",
  "description": "合成演示方案；不是实际科研成果。",
  "category": "趋势分析",
  "cover": "cover.svg",
  "requires": [],
  "dataDescription": "长表格式；第一行表头，每行一条观测。同组横坐标按数值排序。",
  "fields": [
    {
      "key": "x",
      "label": "横坐标",
      "type": "number"
    },
    {
      "key": "y",
      "label": "纵坐标",
      "type": "number"
    },
    {
      "key": "group",
      "label": "系列 / 图例",
      "type": "string"
    }
  ],
  "parameters": [
    {
      "key": "title",
      "label": "图标题",
      "type": "text",
      "default": "Synthetic example"
    },
    {
      "key": "xLabel",
      "label": "X 轴名称",
      "type": "text",
      "default": "X"
    },
    {
      "key": "yLabel",
      "label": "Y 轴名称",
      "type": "text",
      "default": "Y"
    },
    {
      "key": "width",
      "label": "画布宽度 px",
      "type": "number",
      "default": 900,
      "min": 400,
      "max": 2400
    },
    {
      "key": "height",
      "label": "画布高度 px",
      "type": "number",
      "default": 560,
      "min": 300,
      "max": 1800
    },
    {
      "key": "font",
      "label": "字体",
      "type": "select",
      "default": "Arial",
      "options": [
        "Arial",
        "Times New Roman",
        "Microsoft YaHei"
      ]
    },
    {
      "key": "fontSize",
      "label": "字号 px",
      "type": "number",
      "default": 14,
      "min": 8,
      "max": 30
    },
    {
      "key": "color",
      "label": "主色",
      "type": "color",
      "default": "#326b95"
    },
    {
      "key": "color2",
      "label": "第二色",
      "type": "color",
      "default": "#dc8751"
    },
    {
      "key": "legend",
      "label": "图例位置",
      "type": "select",
      "default": "右侧",
      "options": [
        "右侧",
        "左上",
        "隐藏"
      ]
    },
    {
      "key": "yMin",
      "label": "Y 最小值（留空自动）",
      "type": "text",
      "default": ""
    },
    {
      "key": "yMax",
      "label": "Y 最大值（留空自动）",
      "type": "text",
      "default": ""
    },
    {
      "key": "lineWidth",
      "label": "线宽",
      "type": "number",
      "default": 2,
      "min": 0,
      "max": 10
    },
    {
      "key": "marker",
      "label": "标记",
      "type": "select",
      "default": "圆形",
      "options": [
        "圆形",
        "方形",
        "无"
      ]
    },
    {
      "key": "xMin",
      "label": "X 最小值",
      "type": "text",
      "default": ""
    },
    {
      "key": "xMax",
      "label": "X 最大值",
      "type": "text",
      "default": ""
    }
  ]
}