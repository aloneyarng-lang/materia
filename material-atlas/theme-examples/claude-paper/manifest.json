{
  "format": "materia-theme",
  "schemaVersion": 2,
  "name": "Claude · 灰白",
  "description": "暖灰白工作区、黑色交互与陶土橙品牌标识，配英文衬线和中文黑体",
  "tokens": {
    "--paper": "#f9f9f7",
    "--surface": "#ffffff",
    "--canvas": "#f9f9f7",
    "--panel": "#f0efec",
    "--sidebar": "#f5f5f3",
    "--ink": "#131313",
    "--muted": "#666560",
    "--line": "#26251f24",
    "--teal": "#131313",
    "--teal-light": "#e9e8e4",
    "--on-accent": "#ffffff",
    "--brand-mark": "#d97757",
    "--warning": "#795316",
    "--warning-soft": "#f7ecda",
    "--danger": "#a33030",
    "--danger-soft": "#f7e6e4",
    "--shadow": "#24221c18",
    "--serif": "'Lora', Georgia, 'PingFang SC', 'Microsoft YaHei UI', 'Materia Source Han Sans', 'Microsoft YaHei', sans-serif",
    "--sans": "'Lora', Georgia, 'PingFang SC', 'Microsoft YaHei UI', 'Materia Source Han Sans', 'Microsoft YaHei', sans-serif",
    "--radius": "16px",
    "--theme-mode": "light",
    "--mono": "'Materia SF Mono', 'SF Mono', 'Materia Source Code Pro', Consolas, 'PingFang SC', 'Materia Source Han Sans', 'Microsoft YaHei UI', sans-serif",
    "--numeric": "'Materia Inter', 'Segoe UI', 'PingFang SC', 'Microsoft YaHei UI', 'Materia Source Han Sans', 'Microsoft YaHei', sans-serif",
    "--font-size": "14px",
    "--font-weight": "400",
    "--line-height": "1.75",
    "--heading-weight": "500",
    "--heading-line-height": "1.5",
    "--heading-scale": "1.02"
  },
  "graph": {
    "nodeShape": "circle",
    "relationShape": "circle",
    "nodeFill": "solid",
    "edgeStyle": "straight",
    "edgeDash": "solid",
    "background": "plain",
    "colorMode": "accent",
    "nodeScale": 1,
    "nodeStroke": 1.25,
    "edgeWidth": 1,
    "edgeOpacity": 0.27,
    "labelScale": 1,
    "labelHalo": 3,
    "glow": 0,
    "edgeColor": "auto",
    "labelColor": "auto"
  },
  "ui": {
    "style": "glass",
    "density": 1.05,
    "radius": 16,
    "buttonRadius": 18,
    "cardRadius": 20,
    "menuRadius": 18,
    "borderWidth": 1,
    "sidebarWidth": 224,
    "controlHeight": 36,
    "cardPadding": 19,
    "menuPadding": 7,
    "cardGap": 12,
    "buttonStyle": "solid",
    "cardStyle": "outlined",
    "sidebarStyle": "tinted",
    "shadow": "soft"
  },
  "icons": {
    "style": "rounded",
    "strokeWidth": 1.6,
    "size": 18,
    "overrides": {}
  },
  "assets": {
    "fonts": [
      {
        "id": "lora-normal",
        "family": "Lora",
        "format": "ttf",
        "weight": "400 700",
        "style": "normal",
        "file": "Lora-Regular.ttf",
        "source": "https://github.com/google/fonts/tree/main/ofl/lora",
        "licenseFile": "OFL.txt"
      },
      {
        "id": "lora-italic",
        "family": "Lora",
        "format": "ttf",
        "weight": "400 700",
        "style": "italic",
        "file": "Lora-Italic.ttf",
        "source": "https://github.com/google/fonts/tree/main/ofl/lora",
        "licenseFile": "OFL.txt"
      }
    ]
  },
  "variants": {
    "light": {
      "--theme-mode": "light",
      "--paper": "#f9f9f7",
      "--surface": "#ffffff",
      "--canvas": "#f9f9f7",
      "--panel": "#f0efec",
      "--sidebar": "#f5f5f3",
      "--ink": "#131313",
      "--muted": "#666560",
      "--line": "#26251f24",
      "--teal": "#131313",
      "--teal-light": "#e9e8e4",
      "--on-accent": "#ffffff",
      "--warning": "#795316",
      "--warning-soft": "#f7ecda",
      "--danger": "#a33030",
      "--danger-soft": "#f7e6e4",
      "--shadow": "#24221c18"
    },
    "dark": {
      "--theme-mode": "dark",
      "--paper": "#141413",
      "--surface": "#232321",
      "--canvas": "#141413",
      "--panel": "#30302e",
      "--sidebar": "#1a1918",
      "--ink": "#faf9f5",
      "--muted": "#b0aea5",
      "--line": "#fffef02a",
      "--teal": "#eeede9",
      "--teal-light": "#3c3b38",
      "--on-accent": "#141413",
      "--warning": "#f0c584",
      "--warning-soft": "#403323",
      "--danger": "#ffaaa6",
      "--danger-soft": "#472b2b",
      "--shadow": "#00000060"
    }
  }
}
