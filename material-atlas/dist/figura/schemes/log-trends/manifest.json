{
  "id": "log-trends",
  "name": "跨尺度 · 对数趋势",
  "apiVersion": 1,
  "version": "1.0.0",
  "description": "通用数据绘图方案；封面与数据为合成示例，非原论文结果。",
  "category": "趋势分析",
  "cover": "cover.svg",
  "requires": [],
  "fields": [
    {
      "key": "x",
      "label": "横坐标",
      "type": "number"
    },
    {
      "key": "y",
      "label": "纵坐标",
      "type": "number"
    },
    {
      "key": "group",
      "label": "系列名称",
      "type": "string"
    }
  ],
  "parameters": [
    {
      "key": "title",
      "label": "图标题",
      "type": "text",
      "default": "合成示例 · 跨尺度 · 对数趋势"
    },
    {
      "key": "xLabel",
      "label": "X 轴名称",
      "type": "text",
      "default": "X"
    },
    {
      "key": "yLabel",
      "label": "Y 轴名称",
      "type": "text",
      "default": "Y"
    },
    {
      "key": "width",
      "label": "画布宽度 px",
      "type": "number",
      "default": 900,
      "min": 400,
      "max": 2400
    },
    {
      "key": "height",
      "label": "画布高度 px",
      "type": "number",
      "default": 560,
      "min": 300,
      "max": 1800
    },
    {
      "key": "font",
      "label": "字体",
      "type": "select",
      "default": "Arial",
      "options": [
        "Arial",
        "Times New Roman",
        "Microsoft YaHei"
      ]
    },
    {
      "key": "fontSize",
      "label": "字号 px",
      "type": "number",
      "default": 14,
      "min": 8,
      "max": 30
    },
    {
      "key": "palette",
      "label": "配色",
      "type": "select",
      "default": "学术",
      "options": [
        "学术",
        "色觉友好"
      ]
    },
    {
      "key": "lineWidth",
      "label": "线宽",
      "type": "number",
      "default": 2,
      "min": 0.5,
      "max": 8
    },
    {
      "key": "markerSize",
      "label": "标记半径",
      "type": "number",
      "default": 3,
      "min": 0,
      "max": 10
    },
    {
      "key": "xScale",
      "label": "X 坐标尺度",
      "type": "select",
      "default": "对数",
      "options": [
        "线性",
        "对数"
      ]
    },
    {
      "key": "yScale",
      "label": "Y 坐标尺度",
      "type": "select",
      "default": "线性",
      "options": [
        "线性",
        "对数"
      ]
    },
    {
      "key": "order",
      "label": "连线顺序",
      "type": "select",
      "default": "横坐标排序",
      "options": [
        "横坐标排序",
        "表格顺序"
      ]
    }
  ],
  "dataDescription": "长表 x/y/group；对数轴只能用正值。仅改变坐标尺度，不拟合幂律或自动归一化。"
}