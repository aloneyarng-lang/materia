{
  "id": "dual-axis",
  "name": "并观 · 双轴对照",
  "apiVersion": 1,
  "version": "1.0.0",
  "description": "通用数据绘图方案；封面与数据为合成示例，非原论文结果。",
  "category": "趋势分析",
  "cover": "cover.svg",
  "requires": [],
  "fields": [
    {
      "key": "x",
      "label": "公共横坐标",
      "type": "number"
    },
    {
      "key": "left",
      "label": "左轴数值",
      "type": "number"
    },
    {
      "key": "right",
      "label": "右轴数值",
      "type": "number"
    }
  ],
  "parameters": [
    {
      "key": "title",
      "label": "图标题",
      "type": "text",
      "default": "合成示例 · 并观 · 双轴对照"
    },
    {
      "key": "xLabel",
      "label": "X 轴名称",
      "type": "text",
      "default": "X"
    },
    {
      "key": "yLabel",
      "label": "Y 轴名称",
      "type": "text",
      "default": "Y"
    },
    {
      "key": "width",
      "label": "画布宽度 px",
      "type": "number",
      "default": 900,
      "min": 400,
      "max": 2400
    },
    {
      "key": "height",
      "label": "画布高度 px",
      "type": "number",
      "default": 560,
      "min": 300,
      "max": 1800
    },
    {
      "key": "font",
      "label": "字体",
      "type": "select",
      "default": "Arial",
      "options": [
        "Arial",
        "Times New Roman",
        "Microsoft YaHei"
      ]
    },
    {
      "key": "fontSize",
      "label": "字号 px",
      "type": "number",
      "default": 14,
      "min": 8,
      "max": 30
    },
    {
      "key": "palette",
      "label": "配色",
      "type": "select",
      "default": "学术",
      "options": [
        "学术",
        "色觉友好"
      ]
    },
    {
      "key": "lineWidth",
      "label": "线宽",
      "type": "number",
      "default": 2,
      "min": 0.5,
      "max": 8
    },
    {
      "key": "markerSize",
      "label": "标记半径",
      "type": "number",
      "default": 3,
      "min": 0,
      "max": 10
    },
    {
      "key": "rightLabel",
      "label": "右轴名称",
      "type": "text",
      "default": "Right quantity"
    }
  ],
  "dataDescription": "每行 x/left/right；左右轴分别自动定标，须填清单位。双轴只展示共变，不能据视觉重叠推断相关性。"
}